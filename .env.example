# Server-only secret. No VITE_ prefix, so it is never included in the website's JavaScript.
# Locally: put it in .env. On Vercel: Project Settings -> Environment Variables.
GEMINI_API_KEY=your_api_key_here

# Optional: extra sites allowed to call /api (comma-separated). Your own domain is always allowed.
# ALLOWED_ORIGINS=https://example.com

# Optional: name shown in the greeting
VITE_USER_NAME=Karan
